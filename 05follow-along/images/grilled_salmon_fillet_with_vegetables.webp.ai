         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">grilled_salmon_fillet_with_vegetables.webp</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Grilled salmon fillet with vegetable salad. Fresh salad of tomatoes, cucumbers, avocados, sweet peppers and lemon. Large portion on a white plate. Close up and horizontal orientation. &#xA;</rdf:li>
            </rdf:Alt>
         </dc:description>
